# ==============================================================================
# TALVIORA TECH: AI Career Intelligence Platform
# Environment Variables Template
# Copy this file to .env.local and populate with your actual credentials.
# NEVER commit or push .env or .env.local to GitHub or public repositories.
# ==============================================================================

# Supabase Credentials (Database & Authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini API Key (Google AI Studio / Generative AI SDK)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional. Defaults to Google's current stable text model.
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated allowlist of admin sign-in emails for the question inbox
CHAT_INBOX_ADMIN_EMAILS=admin@example.com

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
